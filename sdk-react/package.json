{
  "name": "spres-react",
  "version": "1.2.1",
  "description": "React SDK and chat UI (omago-style streaming ChatWidget, ChatPanel, TrainingPanel, staff dashboard) for the Brainbox AI backend",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/ChatWidget.js",
    "./dist/ChatPanel.js",
    "./dist/TrainingPanel.js",
    "./dist/MessageContent.js",
    "./dist/chatUi.js",
    "./dist/co/*.js",
    "./dist/design/sounds.js",
    "./dist/staff/*.js",
    "./dist/staff/**/*.js"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "jest"
  },
  "keywords": [
    "ai",
    "sdk",
    "spres-ai",
    "react",
    "chat",
    "widget"
  ],
  "author": "Resbrotherx",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "react-syntax-highlighter": "^16.1.1"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "typescript": "^5.4.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
