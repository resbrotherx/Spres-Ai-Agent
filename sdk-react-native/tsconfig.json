{
  "compilerOptions": {
    "target": "ES2019",
    "module": "commonjs",
    "lib": ["ES2019"],
    "jsx": "react-jsx",
    "strict": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "resolveJsonModule": false,
    "types": ["react-native"],
    "baseUrl": ".",
    "paths": { "spres-react-native": ["src"] },
    "outDir": "lib",
    "rootDir": "."
  },
  "include": ["src", "example"]
}
