  "license": "MIT",
  "devDependencies": {
    "@types/react": "^18.3.31",
    "react": "^18.2.0",
    "react-native": "^0.74.5",
    "react-native-svg": "^15.15.5",
    "react-test-renderer": "^18.2.0",
    "typescript": "^5.9.3"
  }
