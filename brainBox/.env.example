# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restai

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Embedding Model
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Security
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# OpenAI Integration (optional)
OPENAI_API_KEY=
USE_OPENAI=false

# Application Settings
DEBUG=true
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# API keys & permissions (see README "Authentication & API keys")
# Enforce API keys on every endpoint except GET / and GET /api/health. false = legacy mode.
REQUIRE_API_KEY=true
# Long random token for /api/admin/keys (X-Admin-Token header). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
BRAINBOX_ADMIN_TOKEN=
# Audience assumed for documents ingested before audiences existed (public keeps old answers).
LEGACY_DOC_AUDIENCE=public

# Staff dashboard (see README "Staff dashboard API")
# JWT_SECRET_KEY above signs staff logins: set a long random value in production
# (the placeholder logs a loud warning at startup).
STAFF_JWT_HOURS=12
# Failed logins allowed per email+IP per window (in-memory, per worker process)
LOGIN_MAX_FAILURES=10
LOGIN_WINDOW_MINUTES=15
# Base URL of the staff dashboard for invite / password-reset links (falls back to the request Origin)
DASHBOARD_URL=
# Knowledge-gap defaults (tenants can override them in PUT /api/settings)
GAP_DISTANCE_THRESHOLD=0.55
EMAIL_MAX_PER_HOUR=20

# Outgoing email (notifications, invites, password resets). Leave SMTP_HOST empty to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Brainbox <no-reply@example.com>
# starttls | ssl | none
SMTP_TLS=starttls
SMTP_TIMEOUT=15

# Database password used by docker-compose (postgres + DATABASE_URL)
POSTGRES_PASSWORD=change-me

# --- Answer speed (see app/config.py) ---
# Local model: qwen2.5:1.5b answers in ~8-10 s on a 4-core CPU (llama3.2:3b ~15-25 s).
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=220
OLLAMA_KEEP_ALIVE=-1
OLLAMA_WARMUP=true
RAG_MAX_CHUNKS=3
RAG_MAX_CHUNK_CHARS=700
# For ~1-3 s answers use a hosted OpenAI-compatible API instead (e.g. Groq or OpenAI):
# LLM_PROVIDER=openai
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.1-8b-instant
